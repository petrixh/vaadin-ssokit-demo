{
  "name": "SSO Kit Demo - Java 21 Dev Container",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "features": {
    //Yes it's cool, DON'T DO THIS IN PRODUCTION!
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "false"
		}
  },

  "mounts": [
    "source=${localEnv:HOME}/.m2,target=/home/vscode/.m2,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.vaadin,target=/dot-vaadin,type=bind,consistency=cached,readonly"
  ], 

  "postCreateCommand": "/workspaces/vaadin-ssokit-demo/.devcontainer/scripts/postCreateScript.sh"
  
}
